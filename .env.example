# OnchainOS API credentials (all three required for HMAC signing).
# Get from https://web3.okx.com/onchainos/dev-portal
ONCHAINOS_API_KEY=your_api_key_uuid
ONCHAINOS_SECRET_KEY=your_secret_key_hex
ONCHAINOS_PASSPHRASE=your_passphrase

# PreflightX attestation key. Generate with `npm run gen-signer`.
# This is a dedicated key used ONLY to sign verified plans.
# Distribute the public address with your skill — verifiers recover the signer
# from the EIP-712 signature and compare against the published address.
PREFLIGHTX_SIGNER_PK=0xyour_64_hex_private_key
PREFLIGHTX_SIGNER_ADDRESS=0xyour_signer_address

# Optional overrides
OKX_BASE_URL=https://web3.okx.com
RPC_URL=https://rpc.xlayer.tech
